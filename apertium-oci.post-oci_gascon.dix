		</pardef>

		<!-- pronom "en" apostrofat (s'apostrofa darrere de verb acabat en vocal o en contacte amb els altres pronoms febles	  -->
		<pardef n="en_apostrofat">
			<e>
				<p>
					<l/>
					<r>'n<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l/>
					<r><b/>n'</r>
				</p>
				<par n="vocal_general"/>
			</e>
		</pardef>
	 
		<!-- converteix "a" en "ad" davant de a i "ada" davant de "eth"-->
		<pardef n="ad_aran">
			<e>
				<p>
					<l><b/><a/>eth<b/></l>
					<r>da<b/>eth<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><b/><a/>era<b/></l> 
					<r>da<b/>era<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><b/><a/>eri<b/></l>
					<r>da<b/>eri<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><b/><a/>eres<b/></l> 
					<r>da<b/>eres<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><b/><a/>a</l>
					<r>d<b/>a</r>
				</p>
			</e>
			<!--	<e>
				<p>
					<l><b/>a</l>
					<r>d<b/>a</r>
				</p>
			</e>-->
	 	</pardef>

		<pardef n="ad_gascon">
			<e>
				<p>
					<l><b/><a/>eth<b/></l>
					<r>d<b/>eth<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><b/><a/>era<b/></l> 
					<r>d<b/>era<b/></r>
				</p>
			</e>
