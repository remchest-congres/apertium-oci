				<p>
					<l>th<b/><a/>de<b/><a/>detes</l>
					<r>th<b/>des</r>
				</p>
			</e>
			<e>
				<p>
					<l>th<b/><a/>de<b/><a/>deteth<b/></l>
					<r>th<b/>der<b/></r>
				</p>
				<par n="vocal_general"/>
			</e>
			<e>
				<p>
					<l>th<b/><a/>de<b/><a/>deteth<b/><a/></l>
					<r>th<b/>der<b/><a/></r>
				</p>
				<par n="vocal_general"/>
			</e>
			
		</pardef>
		<!-- 	 paradigma amb les contraccions dels determinants -->
		<pardef n="contrac_det">
