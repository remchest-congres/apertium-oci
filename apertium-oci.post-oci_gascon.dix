		<!-- pronom "ac" que, a diferència dels altres pronoms febles, no s'apostrofa (fa que s'apostrofi l'altre)	  -->
		<pardef n="apostrofadors">
			<e>
				<par n="vocal_general"/>
			</e>
			<e alt="oci@aran">
				<p>
					<l><a/>ac</l>
					<r>ac</r>
				</p>
			</e>
			<e alt="oci@aran">
				<p>
					<l><a/>enquia<b/><a/></l>
					<r>enquia</r>
				</p>
				<par n="contraccio"/>
			</e>
			<e alt="oci@aran">
