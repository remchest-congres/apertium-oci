					<r>els<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><a/>detles<b/></l>
					<r>els<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><a/>deteths<b/></l>
					<r>eths<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><a/>detes<b/></l>
					<r>es<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><a/>detlas<b/></l>
					<r>las<b/></r>
				</p>
			</e>
			<e>
				<p>
					<l><a/>deteras<b/></l>
					<r>eras<b/></r>
				</p>
			</e>-->
		</pardef>
		<pardef n="eth">
			<e>
				<i>th</i>
				<par n="no_contrac"/>
			</e>
			<e>
				<i>th<b/></i>
				<par n="no_contrac"/>
			</e>
			<e>
				<p>
					<l>th<b/><a/></l>
					<r>th<b/></r>
				</p>
				<par n="no_contrac"/>
			</e>
			<e>
				<p>
					<l>th<b/></l>
					<r>r<b/></r>
				</p>
				<par n="vocal_general"/>
			</e>
			<e>
				<p>
					<l>th<b/><a/></l>
					<r>r<b/></r>
				</p>
				<par n="vocal_general"/>
			</e>
			<e>
				<p>
					<l>th<b/><a/>de<b/><a/>deteth</l>
					<r>th<b/>deth</r>
				</p>
			</e>
			<e>
				<p>
					<l>th<b/><a/>de<b/><a/>detera</l>
					<r>th<b/>dera</r>
				</p>
			</e>
