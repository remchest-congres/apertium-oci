					<r>enquia</r>
				</p>
			</e>
			<e>
				<p>
					<l><a/>e</l>
					<r>e</r>
				</p>
				<par n="eth"/>
			</e>
		</pardef>
		<!-- de davant de eth fa contracció, i no apòstrof	  -->

